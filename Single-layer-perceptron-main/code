class Perceptron:
    """Single Layer Perceptron implemented from scratch."""
 
    def __init__(self, n_features, learning_rate=0.01, epochs=50):
        self.lr = learning_rate
        self.epochs = epochs
    
        self.weights = np.zeros(n_features)
        self.bias = 0.0
        self.errors_history = []
        self.weights_history = []
        self.bias_history = []
    @staticmethod
    def step_activation(z):
        """Step Activation Function: f(z) = 1 if z >= 0 else 0"""
        return np.where(z >= 0, 1, 0)
    def forward(self, X):
        """Weighted sum + activation"""
        z = np.dot(X, self.weights) + self.bias
        return self.step_activation(z)
 
    def fit(self, X, y, verbose=True):
        n_samples = X.shape[0]
 
        for epoch in range(1, self.epochs + 1):
            misclassified = 0
 
            for idx in range(n_samples):
                xi = X[idx]
                target = y[idx]
 
                z = np.dot(xi, self.weights) + self.bias
                y_pred = self.step_activation(z)
 
                error = target - y_pred
                if error != 0:
                    misclassified += 1
                    
                    self.weights += self.lr * error * xi
                    self.bias += self.lr * error
 
            self.errors_history.append(misclassified)
            self.weights_history.append(self.weights.copy())
            self.bias_history.append(self.bias)
 
            if verbose:
                print(f"Epoch {epoch:3d} | Misclassified: {misclassified:4d} | "
                      f"Weights: {np.round(self.weights, 4)} | Bias: {round(self.bias, 4)}")
 
          
            if misclassified == 0:
                if verbose:
                    print(f"\nConverged at epoch {epoch}.")
                break
 
        return self
 
    def predict(self, X):
        return self.forward(X)
 
LEARNING_RATE = 0.01
