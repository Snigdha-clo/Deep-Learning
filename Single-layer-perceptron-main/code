          f"| Final Misclassified = {m.errors_history[-1]:4d} | Test Accuracy = {acc_lr:.4f}")
 
    plt.plot(range(1, len(m.errors_history) + 1), m.errors_history, marker="o", label=f"lr={lr}")
 
